<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>JouleAI</string>
	<key>CFBundleDisplayName</key>
	<string>JouleAI</string>
	<key>CFBundleIdentifier</key>
	<string>com.jouleai.mac</string>
	<key>CFBundleExecutable</key>
	<string>JouleAI</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- LSUIElement = true: no Dock icon, no app menu. JouleAI lives in the menu bar only. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Shown by macOS when JouleAI asks for calendar access (macOS 14+ key). -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>JouleAI reads today's calendar events so you can turn them into commitments.</string>
	<!-- Older key, kept so the prompt text also appears on systems that look for it. -->
	<key>NSCalendarsUsageDescription</key>
	<string>JouleAI reads today's calendar events so you can turn them into commitments.</string>
	<!-- Shown when JouleAI first uses AppleScript (used from Phase 2 to mute audio). -->
	<key>NSAppleEventsUsageDescription</key>
	<string>JouleAI uses AppleScript to mute and restore your audio when a commitment starts, and to check which browser tab you're on during a session.</string>
</dict>
</plist>
